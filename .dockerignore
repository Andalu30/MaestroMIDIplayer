# Dependencies and build artifacts
# (**/ prefix needed: a bare pattern only matches at the context root, which let
#  a host backend/.venv and frontend/node_modules overwrite the image's own)
**/node_modules/
**/.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.svelte-kit/
frontend/build/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo

# Git
.git/
.gitignore

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Documentation and plans
docs/
.claude/
*.md

# OS files
.DS_Store
Thumbs.db

# Dev cache (will be recreated in container)
backend/.cache/

# Local dataset copy (mounted or auto-downloaded at runtime, never baked in)
**/MaestroDataset/
